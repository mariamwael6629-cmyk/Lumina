# Copy this file to .env and adjust values for your environment.

# App
APP_NAME=Lumina API
ENVIRONMENT=development
DEBUG=true

# Security
# Generate a strong secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database
# SQLite by default (zero-config). For Postgres use e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/lumina
DATABASE_URL=sqlite:///./lumina.db

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:8080
